# Example only. Copy to .env for local development; Django loads .env
# automatically and real environment variables always take precedence.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=nasil
POSTGRES_USER=nasil
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
DJANGO_TRUST_PROXY=false
# Readiness probe also checks the Celery broker; defaults to true outside DEBUG.
HEALTHCHECK_BROKER=true
# When using the supplied loopback nginx proxy, trust only its actual peer addresses.
SECURITY_TRUSTED_PROXY_NETWORKS=
# Separate Fernet encryption keys, newest first. Generate securely; never commit values.
SECURITY_ENCRYPTION_KEYS=
# Required in production. Set true locally when enrolling staff authenticators.
SECURITY_REQUIRE_STAFF_MFA=true
# Opt in after validating the actual HTTPS deployment; do not preload casually.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# Durable private media. Production defaults to S3 with short-lived presigned
# URLs; local development uses the filesystem. Filesystem storage outside DEBUG
# requires MEDIA_STORAGE_ALLOW_EPHEMERAL=true and is only for a disposable demo.
# The blank bucket/region below are intentional: fill them before starting with
# this production-shaped example, or set MEDIA_STORAGE_BACKEND=filesystem for
# local development with DJANGO_DEBUG=true.
MEDIA_STORAGE_BACKEND=s3
MEDIA_STORAGE_ALLOW_EPHEMERAL=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Optional S3-compatible endpoint (MinIO, Cloudflare R2). Leave blank for AWS.
AWS_S3_ENDPOINT_URL=
AWS_MEDIA_LOCATION=media
# Presigned URL lifetime in seconds; must be between 60 and 3600.
AWS_QUERYSTRING_EXPIRE=300
# Encrypted backups. Keep the directory off the application volume, restrict it
# to the service account, and alert when the newest backup is older than the
# maximum age. Backups use the same key ring as MFA secrets.
BACKUP_DIRECTORY=/var/backups/nasil
BACKUP_RETENTION_COUNT=14
BACKUP_MAX_AGE_HOURS=26
# NASIL policy: totals above these amounts require Administrator approval.
QUOTATION_APPROVAL_THRESHOLDS={"UGX":"50000000.00","USD":"15000.00"}
# Customer services. Set the canonical HTTPS origin before enabling real delivery.
PUBLIC_SITE_URL=
NOTIFICATIONS_DELIVERY_ENABLED=false
CELERY_BROKER_URL=rediss://your-private-redis-host:6379/0
SENDGRID_API_KEY=
# Use a SendGrid-verified sender address.
DEFAULT_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SANDBOX=false
# Commercial integration traffic stays off until sandbox acceptance passes.
INTEGRATIONS_DELIVERY_ENABLED=false
INTEGRATIONS_SERVICE_USER_ID=
INTEGRATIONS_ALLOWED_HOSTS=api.flutterwave.com,api.sandbox.pawapay.io,api.pawapay.io
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_API_KEY=
ODOO_CUSTOMER_ID_MAP={}
ODOO_SUPPLIER_ID_MAP={}
ODOO_CURRENCY_ID_MAP={}
ODOO_PRODUCT_ID_MAP={}
ODOO_UOM_ID_MAP={}
ODOO_SALES_JOURNAL_ID_MAP={}
ODOO_INCOME_ACCOUNT_ID_MAP={}
ODOO_TAX_ID_MAP={}
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_CURRENCIES=UGX
PAWAPAY_PROVIDERS=
