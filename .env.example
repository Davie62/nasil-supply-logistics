# Example only: export these variables in the hosting environment.
# Django does not automatically read this file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=nasil
POSTGRES_USER=nasil
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
DJANGO_TRUST_PROXY=false
# NASIL policy: totals above these amounts require Administrator approval.
QUOTATION_APPROVAL_THRESHOLDS={"UGX":"50000000.00","USD":"15000.00"}
# Customer services. Set the canonical HTTPS origin before enabling real delivery.
PUBLIC_SITE_URL=
NOTIFICATIONS_DELIVERY_ENABLED=false
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
SENDGRID_API_KEY=
# Use a SendGrid-verified sender address.
DEFAULT_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SANDBOX=false
# Commercial integration traffic stays off until sandbox acceptance passes.
INTEGRATIONS_DELIVERY_ENABLED=false
INTEGRATIONS_SERVICE_USER_ID=
INTEGRATIONS_ALLOWED_HOSTS=api.flutterwave.com,api.sandbox.pawapay.io,api.pawapay.io
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_API_KEY=
ODOO_CUSTOMER_ID_MAP={}
ODOO_SUPPLIER_ID_MAP={}
ODOO_CURRENCY_ID_MAP={}
ODOO_PRODUCT_ID_MAP={}
ODOO_UOM_ID_MAP={}
ODOO_SALES_JOURNAL_ID_MAP={}
ODOO_INCOME_ACCOUNT_ID_MAP={}
ODOO_TAX_ID_MAP={}
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_CURRENCIES=UGX
PAWAPAY_PROVIDERS=
