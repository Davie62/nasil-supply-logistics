# NASIL Celery beat scheduler. Install to /etc/systemd/system/nasil-beat.service.
#
# Exactly one beat process may run per deployment. Running two schedulers
# duplicates every periodic task, including outbox delivery and provider
# dispatch. The schedule database persists between restarts so a restart does
# not reset the last-run clock and replay a burst of overdue tasks.
#
# Reload and enable with:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nasil-beat.service
[Unit]
Description=NASIL Celery beat scheduler
Documentation=file:///srv/nasil/DEPLOYMENT.md
After=network-online.target redis-server.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=nasil
Group=nasil
WorkingDirectory=/srv/nasil
EnvironmentFile=/etc/nasil/nasil.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/nasil/venv/bin/celery -A backend beat \
    --loglevel=info \
    --schedule=/var/lib/nasil/celerybeat-schedule \
    --pidfile=/run/nasil/celerybeat.pid
RuntimeDirectory=nasil
StateDirectory=nasil
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/nasil/logs

[Install]
WantedBy=multi-user.target
