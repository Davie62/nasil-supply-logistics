# Replace hostname, certificate locations and filesystem paths before use.
server {
    listen 80;
    server_name logistics.example.com;
    return 301 https://logistics.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name logistics.example.com;
    ssl_certificate /etc/letsencrypt/live/logistics.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/logistics.example.com/privkey.pem;
    client_max_body_size 8m;
    location /static/ {
        alias /srv/nasil/staticfiles/;
    }
    # Employee photos must not be exposed as public uploads.
    location /media/ {
        return 404;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
